{
	"name": "stock-search-convex",
	"private": true,
	"version": "0.0.0",
	"packageManager": "pnpm@10.28.1",
	"type": "module",
	"workspaces": [
		"llm-harness-js"
	],
	"scripts": {
		"dev": "bash ./start.sh",
		"prepare:vercel-public": "node ./scripts/prepare-vercel-public.mjs",
		"convex:deploy": "pnpm exec convex deploy -y --typecheck disable",
		"deploy": "bash ./scripts/deploy.sh",
		"deploy:preview": "bash ./scripts/deploy.sh --preview",
		"deploy:prod": "bash ./scripts/deploy.sh --prod",
		"deploy:prod:mauve": "bash ./scripts/deploy.sh --prod --alias stock-search-mauve.vercel.app",
		"llm-harness:build": "pnpm --filter llm-harness-js run build",
		"preserver:dev": "pnpm run llm-harness:build",
		"server:dev": "tsx watch src/node.ts",
		"preserver:start": "pnpm run llm-harness:build",
		"server:start": "tsx src/node.ts",
		"premcp:start": "pnpm run llm-harness:build",
		"mcp:start": "tsx src/stock-search/mcp/main.ts",
		"precli": "pnpm run llm-harness:build",
		"cli": "tsx src/stock-search/cli.ts",
		"preserver:typecheck": "pnpm run llm-harness:build",
		"server:typecheck": "tsc --noEmit",
		"server:test": "vitest run --root . server/test",
		"ui:dev": "vite",
		"ui:build": "vite build",
		"ui:preview": "vite preview --host localhost",
		"build": "pnpm run ui:build && pnpm run server:typecheck"
	},
	"dependencies": {
		"@google/genai": "^1.50.1",
		"@hono/node-server": "^1.19.6",
		"@langchain/core": "1.1.40",
		"@langchain/google-genai": "2.1.27",
		"@langchain/langgraph": "1.2.9",
		"@langchain/openai": "1.4.4",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@types/turndown": "^5.0.6",
		"dotenv": "^17.2.3",
		"exa-js": "^2.11.0",
		"fastmcp": "^4.0.0",
		"hono": "^4.10.1",
		"htm": "^3.1.1",
		"langchain": "1.3.3",
		"llm-harness-js": "workspace:*",
		"opencc-js": "^1.0.5",
		"preact": "^10.29.1",
		"turndown": "^7.2.4",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@types/node": "^24.9.1",
		"convex": "^1.32.0",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"vite": "^8.0.8",
		"vitest": "^4.0.7"
	},
	"pnpm": {
		"overrides": {
			"@langchain/core": "1.1.40"
		}
	}
}
