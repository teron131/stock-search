{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm ci && npm run build && npm run prepare:vercel-public",
  "outputDirectory": "public",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(auth(?:/.*)?|portfolio(?:/.*)?|stock/[^/]+/(?:stats|evaluate|news)|stocks|eval|industries|color-standards|realtime-config)",
      "dest": "/api/index"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
